# Copy to .env (git-ignored) and fill in. Used by python drone.py --ai and ai_pilot.py.
# Any OpenAI-compatible chat-completions API works.
SPAR_API_KEY=your-spar-ic-key
# The API root: the part before /chat/completions (usually ends in /v1)
SPAR_BASE_URL=https://your-spar-ic-endpoint/v1
# Pick with: python ai_pilot.py --list-models   (it must support tool calling).
# Comma-separated = fallbacks: if the first stalls or errors, the next one answers.
SPAR_MODEL=spur-glm-5-3,spur-qwen3-235b
# Optional: header for the key if the gateway doesn't use "Authorization: Bearer <key>", e.g. api-key
# SPAR_AUTH_HEADER=api-key
# Optional: how hard reasoning models think. low (default) answers in seconds instead of a minute;
# none turns thinking off where the model allows it (fastest); default leaves it to the model.
# SPAR_REASONING_EFFORT=low
# Optional: seconds to wait for a reply before trying the next model (or retrying once) (default 30)
# SPAR_TIMEOUT=30
# Optional: leave unset if your model rejects temperature
# SPAR_TEMPERATURE=0
